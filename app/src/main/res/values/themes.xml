<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Simkesma" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryContainer">@color/mint</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorError">@color/red</item>
        <item name="android:colorBackground">@color/surface_bg</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="textInputStyle">@style/Widget.Simkesma.Input</item>
        <item name="bottomNavigationStyle">@style/Widget.Simkesma.BottomNav</item>
    </style>
</resources>
