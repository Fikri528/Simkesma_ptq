<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_empty_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_marginTop="12dp">
            <ImageView
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_circle_mint" />
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_mint2"
                android:padding="26dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/logo_ukmptq" />
            </FrameLayout>
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_circle"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_description"
                app:tint="@color/amber_d" />
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_teal"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#CDEFE7"
            android:drawableStart="@drawable/ic_inventory_2"
            android:drawablePadding="6dp"
            android:drawableTint="@color/primary_dark"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyPrimary"
            style="@style/Widget.Simkesma.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_add"
            app:icon="@drawable/ic_cloud_upload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptySecondary"
            style="@style/Widget.Simkesma.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#ECEEED"
            android:text="@string/btn_reset"
            app:icon="@drawable/ic_refresh" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
